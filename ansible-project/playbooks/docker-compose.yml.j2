version: '3.8'

services:
  postgres:
    image: postgres:15-alpine
    environment:
      POSTGRES_USER: "{{ vault_postgres_user }}"
      POSTGRES_PASSWORD: "{{ vault_postgres_password }}"
      POSTGRES_DB: cloud_db
    ports:
      - "5435:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data

  app:
    image: solomon11/cloud:latest
    environment:
      SPRING_DATASOURCE_URL: jdbc:postgresql://postgres:5433/cloud_db
      SPRING_DATASOURCE_USERNAME: "{{ vault_postgres_user }}"
      SPRING_DATASOURCE_PASSWORD: "{{ vault_postgres_password }}"
      MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE: health,info
    depends_on:
      - postgres
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/actuator/health"]
      interval: 1m30s
      timeout: 10s
      retries: 3
    restart: always
    mem_limit: 128m

  prometheus:
    image: prom/prometheus
    volumes:
      - /mnt/c/Users/DELL/Desktop/Cloud/cloud/ansible-project/playbooks/prometheus.yml:/etc/prometheus/prometheus.yml
    ports:
      - "9091:9090"
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'

volumes:
  postgres_data: {}
